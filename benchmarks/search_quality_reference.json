  "fda": [
    {
      "key": "19632393", "report_number": "19632393",
      "brand": "VERSAPORT", "model": "UNVCA12STF", "manufacturer": "COVIDIEN LP",
      "event_date": "2024-05-01", "received_date": "2024-06-28",
      "text": "During the operation, the team identified a leaking trocar seal and replaced the device."
    },
    {
      "key": "20239840", "report_number": "9612501-2024-02372",
      "brand": "VERSAPORT", "model": "ONB12SHF", "manufacturer": "DAVIS & GECK CARIBE LTD",
      "event_date": "2024-08-16", "received_date": "2024-09-17",
      "text": "The trocars leaked and were replaced after loss of pneumoperitoneum. No patient injury was reported.",
      "additional_text": "Concomitant product listed: VersaOne trocar, model ONB5SHF."
    },
    {
      "key": "20273790", "report_number": "2027111-2024-00840",
      "brand": "KII FIOS FIRST ENTRY", "model": "CTF73", "manufacturer": "APPLIED MEDICAL RESOURCES",
      "event_date": "2024-08-26", "received_date": "2024-09-20",
      "text": "An adrenalectomy used a trocar whose sleeve broke during removal. The fragment was recovered. No patient injury was reported. The cannula shaft fractured."
    },
    {
      "key": "20185941", "report_number": "2027111-2024-00825",
      "brand": "KII FIOS FIRST ENTRY", "model": "CTF73", "manufacturer": "APPLIED MEDICAL RESOURCES",
      "event_date": "2024-08-20", "received_date": "2024-09-10",
      "text": "During rib thoracoscopy, the trocar shaft broke. A replacement was used. No patient injury was reported."
    },
    {
      "key": "20348571", "report_number": "2027111-2024-00854",
      "brand": "KII OPTICAL ACCESS SYSTEM", "model": "CTR01", "manufacturer": "APPLIED MEDICAL RESOURCES",
      "event_date": "", "received_date": "2024-10-01",
      "text": "The trocar broke and the fragment was retrieved. Another trocar was inserted. The narrative gives May 2024 without a confirmed occurrence day. No patient injury was reported."
    },
    {
      "key": "20206828", "report_number": "2027111-2024-00827",
      "brand": "KII BALLOON BLUNT TIP SYSTEM", "model": "C0R47", "manufacturer": "APPLIED MEDICAL RESOURCES",
      "event_date": "2024-07-25", "received_date": "2024-09-12",
      "text": "Trocars snagged, making it difficult to insert tools and remove optics. A new trocar was used. No patient injury or illness was reported. The manufacturer could not confirm the reported resistance in testing."
    },
    {
      "key": "23900707", "report_number": "1219930-2025-06071",
      "brand": "VERSAONE", "model": "RSEAL", "manufacturer": "COVIDIEN SURGICAL",
      "event_date": "2025-12-24", "received_date": "2025-12-26",
      "text": "The trocar insufflation port broke and pneumoperitoneum leaked after contact with an adjacent port. No patient injury was reported."
    },
    {
      "key": "24093782", "report_number": "9612501-2026-00122",
      "brand": "VERSAONE", "model": "RNONB8STF", "manufacturer": "DAVIS & GECK CARIBE LTD",
      "event_date": "2025-12-22", "received_date": "2026-01-16",
      "text": "The VersaOne trocar was chipped and broken components were retrieved from the patient cavity. No patient injury was reported."
    }
  ],
